include(GNUInstallDirs)
option(BIT8PAD_BUNDLE_RUNTIME "Deploy private Qt/runtime libraries" ON)
install(TARGETS NotepadNext BUNDLE DESTINATION . RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
install(FILES LICENSE README.md THIRD_PARTY_NOTICES.md DESTINATION ${CMAKE_INSTALL_DATADIR}/doc/8bitpad)
install(DIRECTORY doc/ DESTINATION ${CMAKE_INSTALL_DATADIR}/doc/8bitpad/docs PATTERN "upstream-workflows" EXCLUDE)
install(DIRECTORY licenses/ DESTINATION ${CMAKE_INSTALL_DATADIR}/doc/8bitpad/licenses)
install(DIRECTORY assets/themes/ DESTINATION ${CMAKE_INSTALL_DATADIR}/doc/8bitpad/themes FILES_MATCHING PATTERN "*.md" PATTERN "*.txt" PATTERN "LICENSE*")
foreach(component scintilla lexilla)
    install(FILES "thirdparty/${component}/License.txt" DESTINATION "${CMAKE_INSTALL_DATADIR}/doc/8bitpad/licenses/${component}")
endforeach()
install(FILES thirdparty/uchardet/COPYING DESTINATION ${CMAKE_INSTALL_DATADIR}/doc/8bitpad/licenses/uchardet)
if(UNIX AND NOT APPLE)
    install(FILES deploy/linux/8bitpad.desktop DESTINATION ${CMAKE_INSTALL_DATADIR}/applications)
    install(FILES icon/8bitpad.svg DESTINATION ${CMAKE_INSTALL_DATADIR}/icons/hicolor/scalable/apps)
endif()
if(APPLE)
    set_source_files_properties("${PROJECT_SOURCE_DIR}/icon/8bitpad.icns" PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
    target_sources(NotepadNext PRIVATE "${PROJECT_SOURCE_DIR}/icon/8bitpad.icns")
    set_target_properties(NotepadNext PROPERTIES MACOSX_BUNDLE_ICON_FILE 8bitpad.icns MACOSX_BUNDLE_GUI_IDENTIFIER io.github.8bitpad.App)
endif()
if(BIT8PAD_BUNDLE_RUNTIME)
    if(Qt6_VERSION VERSION_LESS 6.10)
        message(FATAL_ERROR "Release runtime deployment requires Qt >= 6.10")
    endif()
    set(_deploy_plugin_args INCLUDE_PLUGINS qoffscreen)
    if(UNIX AND NOT APPLE)
        set(_deploy_plugin_args INCLUDE_PLUGIN_TYPES platforms)
    endif()
    qt_generate_deploy_app_script(TARGET NotepadNext OUTPUT_SCRIPT _deploy
        NO_COMPILER_RUNTIME ${_deploy_plugin_args})
    install(SCRIPT ${_deploy})
endif()
set(CPACK_PACKAGE_NAME "8bitpad")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "8bitPad native text and code editor")
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
set(CPACK_GENERATOR "TGZ;ZIP")
include(CPack)
