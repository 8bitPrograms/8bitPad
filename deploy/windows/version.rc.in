#include <windows.h>

#define IDI_APP_ICON 1
IDI_APP_ICON ICON "8bitPad.ico"
#include "filetypes.rc"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,0,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "8bitPad"
            VALUE "FileDescription", "8bitPad"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "8bitPad.exe"
            VALUE "LegalCopyright", "@APP_COPYRIGHT@"
            VALUE "OriginalFilename", "8bitPad.exe"
            VALUE "ProductName", "8bitPad"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
